NODE_ENV=development
PORT=8088

# postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_POOL_MAX=10

# JWT (生产请用 openssl rand -base64 64 生成)
JWT_SECRET=replace-with-random-64-chars-string
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# bcrypt (cost 12 默认，dev 可调低)
BCRYPT_COST=12

# verification TTL
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# 2FA
TOTP_ISSUER=ManhuaWorks

# email
EMAIL_FROM=no-reply@example.com
EMAIL_MOCK_LOG=true

# logger
LOG_LEVEL=info
