NODE_ENV=development
PORT=8088

# postgres
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_POOL_MAX=10

# JWT (鐢熶骇璇风敤 openssl rand -base64 64 鐢熸垚)
JWT_SECRET=replace-with-random-64-chars-string
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# bcrypt (cost 12 榛樿锛宒ev 鍙皟浣?
BCRYPT_COST=12

# verification TTL
EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1

# 2FA
TOTP_ISSUER=ManhuaWorks

# email (娲惧崟 14: 闃块噷浜?DirectMail)
EMAIL_FROM=noreply@qianjigongfang.com
EMAIL_MOCK_LOG=false

# SMTP 鈥?闃块噷浜?DirectMail (娲惧崟 14)
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=noreply@qianjigongfang.com
# SMTP_PASSWORD=璇峰湪闃块噷浜?DirectMail 鎺у埗鍙板垱寤哄悗濉€?SMTP_PASSWORD=
EMAIL_CODE_TTL_SEC=600
EMAIL_RATE_LIMIT_PER_HOUR=5
EMAIL_MOCK=true   # dev 榛樿 mock, 濉?SMTP_PASSWORD 鍚庢敼 false

# logger
LOG_LEVEL=info

# 千机工坊 6 子名 (派单 13)
SUB_NAME_MANHUA=千机·漫
SUB_NAME_NOVEL=千机·书
SUB_NAME_MUSIC=千机·曲
SUB_NAME_PROMO=千机·片
SUB_NAME_AD=千机·图
SUB_NAME_VIDEO=千机·影

# 千机工坊品牌元数据
BRAND_NAME_CN=千机工坊
BRAND_NAME_PY=qianjigongfang
BRAND_DOMAIN_PRIMARY=qianjigongfang.com
BRAND_DOMAIN_SECONDARY=qianjigongfang.cn
BRAND_FROM_PRIMARY=noreply@qianjigongfang.com
