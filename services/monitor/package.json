{
  "name": "@manhuaworks/monitor",
  "version": "0.1.0",
  "private": true,
  "description": "ManhuaWorks monitor - health probing, metrics scraping, threshold/anomaly rules, alert routing (feishu/email/webhook)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
