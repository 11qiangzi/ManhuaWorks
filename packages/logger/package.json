{
  "name": "@manhuaworks/logger",
  "version": "0.1.0",
  "private": true,
  "description": "ManhuaWorks structured logger + OpenTelemetry tracer + prom-client metrics + express/ws middleware",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "on-finished": "^2.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "8.18.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "8.21.0"
  },
  "peerDependencies": {
    "express": "^4.21.0",
    "ws": "^8.0.0"
