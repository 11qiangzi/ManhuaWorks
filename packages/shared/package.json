{
  "name": "@manhuaworks/shared",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ManhuaWorks shared backend utilities — unified auth, errors, health, middleware",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./middleware/*": "./src/middleware/*.ts",
    "./types/*": "./src/types/*.ts",
    "./middleware/auth": "./src/middleware/auth.ts",
    "./middleware/error-handler": "./src/middleware/error-handler.ts",
    "./middleware/health": "./src/middleware/health.ts",
    "./middleware/rate-limit": "./src/middleware/rate-limit.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "express": "^4.21.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
