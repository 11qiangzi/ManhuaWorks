{
  "_meta": {
    "name": "漫工场统一术语表 - P0 林知行审定",
    "version": "1.0.0",
    "date": "2026-06-10",
    "author": "林知行 (内容部长) · 方琢 (编辑)",
    "scope": "web / studio / user-portal / admin-portal / ops-portal",
    "principle": "中文优先, 动作优先, 禁止中英混杂. 一个概念一个词, 跨 5 站统一."
  },
  "terms": {
    "project": { "zh": "项目", "en": "Project", "note": "不叫「工程」「作品」(作品=已发布的成品)", "scope": "all" },
    "work": { "zh": "作品", "en": "Work", "note": "已发布/待发布的漫剧成品, 区别于草稿态「项目」", "scope": "all" },
    "studio": { "zh": "创作工作台", "en": "Creator Studio", "note": "不叫「工作室」「制作中心」, 统一叫「创作工作台」", "scope": "all" },
    "storyboard": { "zh": "分镜", "en": "Storyboard", "note": "不叫「镜头/Shot/Frame」, 严格统一为「分镜」", "scope": "studio" },
    "shot": { "zh": "镜头", "en": "Shot", "note": "分镜下的单格画面, 不叫「帧/卡片」", "scope": "studio" },
    "frame": { "zh": "帧", "en": "Frame", "note": "视频播放的最小时间单位, 不叫「画格」", "scope": "studio" },
    "episode": { "zh": "集", "en": "Episode", "note": "不叫「章节」, 集=发布单位", "scope": "studio" },
    "scene": { "zh": "场景", "en": "Scene", "note": "分镜所属的地点/情境单元", "scope": "studio" },
    "character": { "zh": "角色", "en": "Character", "note": "不叫「人物」, 统一「角色」", "scope": "studio" },
    "asset": { "zh": "素材", "en": "Asset", "note": "不叫「资源/文件」, 「素材库」统一叫法", "scope": "all" },
    "template": { "zh": "模板", "en": "Template", "note": "预设项目/分镜模板", "scope": "all" },
    "dashboard": { "zh": "工作台", "en": "Dashboard", "note": "用户端叫「工作台」, 管理端叫「仪表盘」", "scope": "user-portal" },
    "dashboard_admin": { "zh": "仪表盘", "en": "Dashboard", "note": "admin/ops 端叫「仪表盘」, 带数据监控意味", "scope": "admin-portal,ops-portal" },
    "subscription": { "zh": "订阅", "en": "Subscription", "note": "不叫「套餐/会员」, 订阅=按月/年付费计划", "scope": "user-portal" },
    "billing": { "zh": "计费", "en": "Billing", "note": "不叫「账单」, 计费=系统层面扣费逻辑", "scope": "admin-portal" },
    "invoice": { "zh": "发票", "en": "Invoice", "note": "用户可申请/查看的电子发票", "scope": "user-portal" },
    "team": { "zh": "团队", "en": "Team", "note": "不叫「组织/工作组」", "scope": "user-portal" },
    "member": { "zh": "成员", "en": "Member", "note": "团队成员, 不叫「用户」", "scope": "user-portal" },
    "collaborator": { "zh": "协作者", "en": "Collaborator", "note": "被邀请编辑项目的非团队用户", "scope": "studio" },
    "export": { "zh": "导出", "en": "Export", "note": "不叫「下载/输出」", "scope": "studio" },
    "publish": { "zh": "发布", "en": "Publish", "note": "不叫「上线/上架/公开」", "scope": "all" },
    "draft": { "zh": "草稿", "en": "Draft", "note": "未发布态的作品/项目", "scope": "all" },
    "review": { "zh": "审核", "en": "Review", "note": "不叫「审查/审批」", "scope": "ops-portal" },
