    "quota": { "zh": "配额", "en": "Quota", "note": "用户/团队的使用限额, 不叫「限制/额度」", "scope": "all" },
    "rate_limit": { "zh": "频率限制", "en": "Rate Limit", "note": "API 级别限流, 不叫「限速/限流」", "scope": "admin-portal" },
    "api_key": { "zh": "API 密钥", "en": "API Key", "note": "不叫「Key/Access Token」", "scope": "all" },
    "recharge": { "zh": "充值", "en": "Recharge", "note": "不叫「加钱/充值余额」", "scope": "user-portal" },
    "balance": { "zh": "余额", "en": "Balance", "note": "账户可用余额", "scope": "user-portal" },
    "recycle_bin": { "zh": "回收站", "en": "Trash", "note": "不叫「废纸篓/垃圾箱」", "scope": "user-portal" },
    "settings": { "zh": "设置", "en": "Settings", "note": "不叫「配置/偏好」(配置=系统级)", "scope": "all" },
    "profile": { "zh": "个人资料", "en": "Profile", "note": "用户个人信息, 不叫「账户/账号」", "scope": "all" },
    "account": { "zh": "账户", "en": "Account", "note": "账单/订阅/安全统一入口", "scope": "user-portal" },
    "sign_in": { "zh": "登录", "en": "Sign In", "note": "不叫「登陆/进入」", "scope": "all" },
    "sign_up": { "zh": "注册", "en": "Sign Up", "note": "不叫「加入/开通」", "scope": "all" },
    "sign_out": { "zh": "退出登录", "en": "Sign Out", "note": "不叫「注销/登出」", "scope": "all" },
    "forgot_password": { "zh": "忘记密码", "en": "Forgot Password", "note": "", "scope": "all" },
    "reset": { "zh": "重置", "en": "Reset", "note": "密码/设置重置, 不叫「恢复默认」", "scope": "all" }
  },
  "action_verbs": {
    "create": { "zh": "新建", "en": "Create", "note": "不叫「创建/增加」, 新建偏用户动作", "scope": "all" },
    "edit": { "zh": "编辑", "en": "Edit", "note": "不叫「修改/更改」", "scope": "all" },
    "delete": { "zh": "删除", "en": "Delete", "note": "不叫「移除/去掉」, 「移除」用于成员移除", "scope": "all" },
    "remove": { "zh": "移除", "en": "Remove", "note": "仅用于成员/协作者移除", "scope": "user-portal,studio" },
    "save": { "zh": "保存", "en": "Save", "note": "不叫「存储/记下」", "scope": "all" },
    "cancel": { "zh": "取消", "en": "Cancel", "note": "不叫「放弃/回去」", "scope": "all" },
    "confirm": { "zh": "确认", "en": "Confirm", "note": "不叫「确定/好的」", "scope": "all" },
    "submit": { "zh": "提交", "en": "Submit", "note": "表单提交动作", "scope": "all" },
    "upload": { "zh": "上传", "en": "Upload", "note": "", "scope": "all" },
    "download": { "zh": "下载", "en": "Download", "note": "", "scope": "all" },
    "share": { "zh": "分享", "en": "Share", "note": "不叫「转发/共享」", "scope": "all" },
    "invite": { "zh": "邀请", "en": "Invite", "note": "团队成员邀请", "scope": "user-portal" },
    "search": { "zh": "搜索", "en": "Search", "note": "不叫「查找/检索」", "scope": "all" },
    "filter": { "zh": "筛选", "en": "Filter", "note": "不叫「过滤」", "scope": "all" },
    "sort": { "zh": "排序", "en": "Sort", "note": "", "scope": "all" },
    "copy": { "zh": "复制", "en": "Copy", "note": "复制内容/项目", "scope": "all" },
    "duplicate": { "zh": "创建副本", "en": "Duplicate", "note": "创建项目副本, 区别于剪贴板「复制」", "scope": "studio" },
    "regenerate": { "zh": "重新生成", "en": "Regenerate", "note": "AI 重新生成分镜/图片", "scope": "studio" },
    "replace": { "zh": "替换", "en": "Replace", "note": "替换当前选中素材", "scope": "studio" },
    "restore": { "zh": "恢复", "en": "Restore", "note": "从回收站恢复", "scope": "user-portal" },
    "archive": { "zh": "归档", "en": "Archive", "note": "不叫「存档」, 归档=移入只读状态", "scope": "all" }
  },
  "error_messages": {
    "generic_error": { "zh": "操作失败, 请稍后重试", "note": "通用错误, 不叫「出了点问题/Something went wrong」" },
