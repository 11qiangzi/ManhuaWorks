    "log": { "zh": "日志", "en": "Log", "note": "系统运行日志, 区别于审计", "scope": "admin-portal" },
    "ticket": { "zh": "工单", "en": "Ticket", "note": "客服/支持工单", "scope": "ops-portal" },
    "campaign": { "zh": "活动", "en": "Campaign", "note": "营销活动/促销活动, 不叫「营销/推广」", "scope": "ops-portal" },
    "coupon": { "zh": "优惠券", "en": "Coupon", "note": "不叫「折扣券/代金券」", "scope": "ops-portal" },
