{
  "name": "@manhuaworks/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ManhuaWorks - Shared UI package: themes, animations, responsive composables, mobile components.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./themes": "./src/themes/index.ts",
    "./themes/*": "./src/themes/*",
    "./composables": "./src/composables/index.ts",
    "./composables/*": "./src/composables/*",
    "./animations": "./src/animations/index.ts",
    "./animations/*": "./src/animations/*",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*",
    "./styles/*.css": "./src/styles/*.css",
    "./tailwind.base": "./tailwind.base.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.5",
    "happy-dom": "^14.12.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "vue": "^3.4.21"
  }
}
