{
  "name": "manhuaworks",
  "version": "0.1.0",
  "private": true,
  "description": "ManhuaWorks - 漫改 SaaS 平台（W1-D1 工程基线）",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "docker:build": "docker compose -f infrastructure/docker-compose.yml build",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "dependencies": {
    "@manhuaworks/api-client": "workspace:*",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.55.0",
    "@opentelemetry/resources": "1.28.0",
    "@opentelemetry/sdk-node": "0.55.0",
    "@opentelemetry/semantic-conventions": "1.28.0",
    "ioredis": "5.4.1",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.10",
    "@types/ws": "^8.18.1",
    "@vue/test-utils": "^2.4.5",
    "playwright": "^1.60.0",
    "ws": "^8.21.0"
  }
}
