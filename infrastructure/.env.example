# ManhuaWorks — Environment Variables
# 2026-06-08 谢擎 L2-task-12
#
# 复制：cp .env.example .env  &&  $EDITOR .env
# 永远不要把真实 .env 提交到 git。

# ============================================================
# === 业务核心 ===
# ============================================================

# 运行环境：development | staging | production
NODE_ENV=production

# 全局日志级别：trace | debug | info | warn | error
LOG_LEVEL=info

# CORS 允许的来源（逗号分隔，* 表示全部）
CORS_ORIGIN=*

# ============================================================
# === Postgres ===
# ============================================================
POSTGRES_USER=mhw
POSTGRES_PASSWORD=change_me_postgres_password_32chars
POSTGRES_DB=manhuaworks
# 容器内连接串（由 docker-compose 内部组装；外部调试时可手动改）
DATABASE_URL=postgresql://mhw:change_me_postgres_password_32chars@postgres:5432/manhuaworks
DATABASE_POOL_MAX=10

# ============================================================
# === Redis ===
# ============================================================
REDIS_URL=redis://redis:6379
# 如果生产环境 redis 启用了 AUTH，在这里设置
REDIS_PASSWORD=

# ============================================================
# === JWT / 鉴权 ===
# ============================================================
# 必须 ≥32 字符；生产环境用 openssl rand -hex 64 生成
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long
# access token 有效期（秒）默认 15 分钟
JWT_ACCESS_TTL=900
# refresh token 有效期（秒）默认 30 天
JWT_REFRESH_TTL=2592000

# ============================================================
# === SMTP（邮件验证码 / 告警） ===
# ============================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@manhuaworks.com
SMTP_PASS=change_me_smtp_password
SMTP_FROM=ManhuaWorks <noreply@manhuaworks.com>

# ============================================================
# === 飞书告警 Webhook ===
# ============================================================
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# ============================================================
# === 告警分发 ===
# ============================================================
ALERT_FROM=alerts@manhuaworks.local
ALERT_TO=ops@manhuaworks.local

# ============================================================
# === 配额 / 计费 ===
# ============================================================
QUOTA_RESET_INTERVAL_SEC=86400

# ============================================================
# === API Gateway 限流 ===
# ============================================================
# 单 IP 每分钟最大请求数
RATE_LIMIT_PER_MIN=120

# ============================================================
# === Grafana ===
# ============================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_admin_16chars
GF_SERVER_ROOT_URL=http://localhost:3010

# ============================================================
# === 前端 Vite (vite build 时注入) ===
# ============================================================
# 浏览器调用后端的地址（开发时是宿主 localhost）
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8091/ws

# ============================================================
# === 杂项 ===
# ============================================================
# 启动顺序：postgres → redis → backend → frontend / observability
COMPOSE_PROJECT_NAME=manhuaworks

# === L2 task 11: monitor service alertmanager channels ===
FEISHU_WEBHOOK_URL_DEFAULT=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE
FEISHU_WEBHOOK_URL_CRITICAL=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_CRITICAL
FEISHU_WEBHOOK_URL_WARNING=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_WARNING
FEISHU_WEBHOOK_URL_BILLING=https://open.feishu.cn/open-apis/bot/v2/hook/REPLACE_BILLING
ALERT_EMAIL_TO=oncall@manhuaworks.com
